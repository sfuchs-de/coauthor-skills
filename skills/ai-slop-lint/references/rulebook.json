{
  "version": "2026-05-21",
  "derived_from": "references/compendium.md",
  "description": "Machine-readable AI-style lint rulebook distilled from the compendium. Use as style-lint evidence, not authorship proof.",
  "hard_artifact_phrases": [
    "as an ai language model",
    "as a large language model",
    "as an artificial intelligence",
    "as of my last update",
    "as of my last knowledge update",
    "up to my last training update",
    "regenerate response",
    "i do not have access to",
    "i don't have access to",
    "based on available information",
    "turn0search",
    "turn0image",
    "turn0news",
    "turn0file",
    "contentreference",
    "contentReference",
    "oaicite",
    "oai_citation",
    "attached_file",
    "grok_card",
    "utm_source=chatgpt.com",
    "utm_source=claude.ai",
    "utm_source=perplexity.ai",
    "certainly!",
    "of course!",
    "great question!",
    "i hope this helps",
    "let me know if",
    "would you like me to"
  ],
  "phrase_rules": [
    {
      "rule_id": "compendium-phrase-generic-scene-setter",
      "category": "generic scene setter",
      "priority": "P1",
      "weight": 3,
      "phrases": [
        "it is important to note",
        "it's important to note",
        "it is worth noting",
        "it's worth noting",
        "needless to say",
        "in today's",
        "today's fast-paced world",
        "in the realm of",
        "in a world where",
        "when it comes to",
        "at its core",
        "at the end of the day"
      ],
      "why": "Generic scene-setting delays the specific claim.",
      "edit": "Start with the actor, event, evidence, or question.",
      "sources": ["compendium", "stop-slop", "Bloomberry", "GPTZero"]
    },
    {
      "rule_id": "compendium-phrase-business-filler",
      "category": "business and strategy filler",
      "priority": "P2",
      "weight": 2,
      "phrases": [
        "navigate challenges",
        "lean into",
        "game-changer",
        "double down",
        "deep dive",
        "take a step back",
        "moving forward",
        "circle back",
        "on the same page",
        "best practices",
        "actionable insights",
        "move the needle",
        "paradigm shift",
        "speaks volumes",
        "thought leader",
        "thought leadership",
        "food for thought",
        "playbook",
        "signal vs noise",
        "hold space",
        "making an impact",
        "impacting"
      ],
      "why": "Business filler and abstract strategy phrases can replace concrete claims.",
      "edit": "Replace with the specific action, mechanism, metric, or decision.",
      "sources": ["compendium", "stop-slop", "aismells"]
    },
    {
      "rule_id": "compendium-phrase-significance-inflation",
      "category": "significance inflation",
      "priority": "P1",
      "weight": 3,
      "phrases": [
        "plays a significant role in shaping",
        "plays a crucial role in determining",
        "stands as a testament",
        "underscores the significance of",
        "shaping the landscape",
        "transformative power",
        "the implications are significant",
        "the stakes are high",
        "the consequences are real",
        "a major step in the right direction"
      ],
      "why": "Inflated importance language often substitutes for evidence.",
      "edit": "Replace with the concrete fact, consequence, actor, date, or metric.",
      "sources": ["compendium", "Wikipedia", "JohnCrickett"]
    },
    {
      "rule_id": "compendium-phrase-false-suspense",
      "category": "false suspense",
      "priority": "P1",
      "weight": 3,
      "phrases": [
        "the reality is",
        "here's the thing",
        "here's the kicker",
        "here's where it gets interesting",
        "here's what i find interesting",
        "here's the problem though",
        "here's the starting point",
        "here's the deal",
        "the uncomfortable truth is",
        "it turns out",
        "the real question is",
        "the truth is simple",
        "the heart of the matter"
      ],
      "why": "False suspense makes ordinary transitions sound assistant-written.",
      "edit": "Delete the setup and state the point directly.",
      "sources": ["compendium", "stop-slop", "tropes.fyi"]
    },
    {
      "rule_id": "compendium-phrase-hook-formulas",
      "category": "hook formula",
      "priority": "P1",
      "weight": 3,
      "phrases": [
        "have you ever wondered",
        "let's be honest",
        "most people believe",
        "they're wrong",
        "stop doing",
        "start doing",
        "i used to think",
        "i was wrong",
        "what if the way we think about",
        "is changing the way",
        "is more than just"
      ],
      "why": "Formulaic hooks create a social-post cadence rather than draft-specific prose.",
      "edit": "Replace with the actual thesis or opening fact.",
      "sources": ["compendium", "Bloomberry", "TechHarvey"]
    },
    {
      "rule_id": "compendium-phrase-pedagogical-handholding",
      "category": "pedagogical hand-holding",
      "priority": "P1",
      "weight": 3,
      "phrases": [
        "let's unpack",
        "let's dive in",
        "let's break this down",
        "let's break this down step by step",
        "let me walk you through",
        "in this section, we'll",
        "as we'll see",
        "i want to explore",
        "think of it as",
        "think of it like",
        "think about it",
        "imagine a world where"
      ],
      "why": "Chatty instruction framing often belongs to the assistant, not the author.",
      "edit": "Remove the hand-holding and make the analytical move directly.",
      "sources": ["compendium", "stop-slop", "avoid-ai-writing"]
    },
    {
      "rule_id": "compendium-phrase-emphasis-crutch",
      "category": "emphasis crutch",
      "priority": "P1",
      "weight": 3,
      "phrases": [
        "full stop",
        "let that sink in",
        "make no mistake",
        "here's why that matters",
        "plot twist",
        "spoiler",
        "you already know this, but",
        "and yes",
        "since we're being honest",
        "this is not a rant",
        "it's a diagnosis",
        "the reasons are structural",
        "history is clear",
        "history is unambiguous"
      ],
      "why": "Performative emphasis often replaces sharper evidence or argument.",
      "edit": "Cut the emphasis cue; keep the evidence-bearing sentence.",
      "sources": ["compendium", "stop-slop"]
    },
    {
      "rule_id": "compendium-phrase-hedging-filler",
      "category": "hedging or filler",
      "priority": "P2",
      "weight": 2,
      "phrases": [
        "it goes without saying",
        "it bears mentioning",
        "that being said",
        "to be clear",
        "in other words",
        "on the other hand",
        "at the same time",
        "in the grand scheme of things",
        "in a nutshell",
        "in order to",
        "due to the fact that",
        "at this point in time",
        "in the event that",
        "has the ability to",
        "while specific details are limited",
        "while specific details are scarce"
      ],
      "why": "Filler and hedging phrases slow the prose and create a generic assistant register.",
      "edit": "Delete or replace with the simpler equivalent.",
      "sources": ["compendium", "humanize-writing", "avoid-ai-writing"]
    },
    {
      "rule_id": "repo-phrase-vague-worth-endorsement",
      "category": "vague endorsement",
      "priority": "P2",
      "weight": 2,
      "phrases": [
        "worth reading",
        "worth checking out",
        "worth exploring",
        "worth a look",
        "worth paying attention to",
        "worth your time"
      ],
      "why": "Worth-X endorsements substitute a generic thumbs-up for the specific reason the item matters.",
      "edit": "Say why the thing matters, or cut the endorsement.",
      "sources": ["conorbronsdon/avoid-ai-writing"],
      "blocking": false
    },
    {
      "rule_id": "compendium-phrase-generic-conclusion",
      "category": "generic conclusion",
      "priority": "P1",
      "weight": 3,
      "phrases": [
        "in conclusion",
        "in summary",
        "overall",
        "to summarize",
        "only time will tell",
        "the future looks bright",
        "exciting times lie ahead"
      ],
      "why": "Formulaic conclusions often add no content.",
      "edit": "Delete the transition or end on a concrete final point.",
      "sources": ["compendium", "Wikipedia", "TechHarvey"]
    },
    {
      "rule_id": "repo-phrase-organizing-object",
      "category": "academic meta-scaffolding",
      "priority": "P2",
      "weight": 2,
      "phrases": [
        "organizing object"
      ],
      "why": "Organizing object is a vague meta-label when the sentence can name the actual equation, cutoff, statistic, or comparison.",
      "edit": "Name the specific object or state its role directly.",
      "sources": ["compendium", "project-review"],
      "blocking": false
    }
  ],
  "regex_rules": [
    {
      "rule_id": "compendium-regex-negative-parallelism",
      "category": "formulaic sentence template",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\bnot\\s+(?:just\\s+)?[^.!?;]{1,80}\\bbut\\s+(?:also\\s+)?[^.!?;]{1,80}",
      "why": "The not-X-but-Y template is a common LLM rhetorical crutch.",
      "edit": "State the positive claim directly.",
      "sources": ["compendium", "Wikipedia", "Washington Post"]
    },
    {
      "rule_id": "compendium-regex-not-x-it-is-y",
      "category": "formulaic sentence template",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\bit'?s\\s+not\\s+[^.!?;]{1,80}\\bit'?s\\s+[^.!?;]{1,80}",
      "why": "The not-X-it-is-Y shape creates polished but mechanical contrast.",
      "edit": "Make the positive claim directly.",
      "sources": ["compendium", "Wikipedia"]
    },
    {
      "rule_id": "compendium-regex-no-no-just",
      "category": "dramatic fragmentation",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\bno\\s+[^.!?]{1,50}\\.\\s+no\\s+[^.!?]{1,50}\\.\\s+just\\s+[^.!?]{1,80}",
      "why": "Stacked negative fragments create a synthetic punchline cadence.",
      "edit": "Combine into one direct sentence.",
      "sources": ["compendium", "stop-slop"]
    },
    {
      "rule_id": "compendium-regex-immediate-rhetorical-qa",
      "category": "rhetorical Q&A",
      "priority": "P1",
      "weight": 2,
      "pattern": "\\bthe\\s+\\w+\\?\\s+[A-Z][^.!?]{1,80}[.!?]",
      "why": "Immediate Q&A transitions can make the prose sound templated.",
      "edit": "State the answer without staging the question unless the question is doing real work.",
      "sources": ["compendium", "stop-slop"]
    },
    {
      "rule_id": "compendium-regex-false-range",
      "category": "false range",
      "priority": "P1",
      "weight": 2,
      "pattern": "\\bfrom\\s+[^,.;:!?]{3,60}\\s+to\\s+[^,.;:!?]{3,80}",
      "why": "From-X-to-Y phrasing can imply a scale where none exists.",
      "edit": "List the real categories or specify the actual range.",
      "sources": ["compendium", "JohnCrickett"]
    },
    {
      "rule_id": "compendium-regex-copula-avoidance",
      "category": "copula avoidance",
      "priority": "P1",
      "weight": 2,
      "pattern": "\\bserves\\s+as\\b|\\bstands\\s+as\\b|\\bboasts\\s+(?:a|an|over|more|\\d)\\b|\\bfeatures\\s+(?:a|an|over|more|\\d)\\b",
      "why": "Fancy linking verbs often replace simpler and clearer verbs.",
      "edit": "Use is, has, contains, or the precise action verb.",
      "sources": ["compendium", "Wikipedia"]
    },
    {
      "rule_id": "compendium-regex-stacked-modal-hedge",
      "category": "hedging cluster",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\bcould\\s+potentially\\b|\\bmay\\s+eventually\\b|\\bmight\\s+ultimately\\b",
      "why": "Stacked modal hedges often add caution without information.",
      "edit": "Use one hedge, or state the condition that makes the claim uncertain.",
      "sources": ["compendium", "avoid-ai-writing"]
    },
    {
      "rule_id": "compendium-regex-participial-tail",
      "category": "superficial participial analysis",
      "priority": "P1",
      "weight": 3,
      "pattern": ",\\s+\\b(highlighting|showcasing|reflecting|ensuring|contributing|underscoring|emphasizing)\\b[^.!?]{0,120}[.!?]",
      "why": "Tacked-on -ing analysis often gestures at significance without proving it.",
      "edit": "Cut the clause or convert it into a sourced claim.",
      "sources": ["compendium", "Wikipedia", "Reinhart"]
    },
    {
      "rule_id": "compendium-regex-nominalization",
      "category": "nominalization",
      "priority": "P2",
      "weight": 1,
      "pattern": "\\b(the\\s+)?(implementation|optimization|integration|development|utilization|enhancement)\\s+of\\b",
      "why": "Noun-heavy wording can make prose abstract and impersonal.",
      "edit": "Prefer the active verb when no technical distinction is lost.",
      "sources": ["compendium", "Reinhart"]
    },
    {
      "rule_id": "compendium-regex-wh-opener",
      "category": "sentence-start crutch",
      "priority": "P2",
      "weight": 1,
      "pattern": "^(What|When|Where|Which|Who|Why|How)\\b",
      "why": "Repeated Wh-word openings can create a canned explanatory cadence.",
      "edit": "Vary openings or state the point directly.",
      "sources": ["compendium", "stop-slop"]
    },
    {
      "rule_id": "compendium-regex-so-look-opener",
      "category": "sentence-start crutch",
      "priority": "P2",
      "weight": 1,
      "pattern": "^\\s*(So,|Look,)\\s+",
      "why": "Conversational setup words can make prose sound like a chat reply.",
      "edit": "Cut the setup word unless it matches the author's voice.",
      "sources": ["compendium", "stop-slop"]
    },
    {
      "rule_id": "compendium-regex-lazy-extreme",
      "category": "lazy extreme",
      "priority": "P2",
      "weight": 1,
      "pattern": "\\b(every|always|never|everyone|everybody|nobody|no one)\\b",
      "why": "Absolute claims often overstate the evidence.",
      "edit": "Qualify with the real scope or replace with evidence.",
      "sources": ["compendium", "stop-slop"]
    },
    {
      "rule_id": "compendium-regex-vague-consensus",
      "category": "vague attribution",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\b(consensus|widespread agreement|most experts|most scholars|widely accepted|universally acknowledged)\\b",
      "why": "Consensus language needs a named source or clear evidence.",
      "edit": "Name the source, field, or evidence base; otherwise cut it.",
      "sources": ["compendium", "Wikipedia"]
    },
    {
      "rule_id": "repo-regex-colon-gloss-scaffolding",
      "category": "academic meta-scaffolding",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\b(?:is|are|was|were|remains?|becomes?|became)\\s+[^.!?\\n:]{2,90}:\\s+[^.!?\\n]{8,160}",
      "why": "Repeated label-colon explanations can sound like assistant exposition, especially in theory prose.",
      "edit": "Split the sentence or state the relation directly without a colon gloss.",
      "sources": ["compendium", "project-review"],
      "blocking": false
    },
    {
      "rule_id": "compendium-regex-importance-ing",
      "category": "superficial analysis",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\b[\\w-]+ing\\s+(the\\s+)?(importance|significance|need|role|impact)\\s+of\\b",
      "why": "Generic -ing claims about importance or impact often avoid the actual mechanism.",
      "edit": "State the mechanism, evidence, or consequence.",
      "sources": ["compendium", "Wikipedia"]
    },
    {
      "rule_id": "repo-regex-notability-name-dropping",
      "category": "notability name-dropping",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\b(?:featured|covered|mentioned|reported|recognized|highlighted)\\s+(?:in|by)\\s+[^.!?]{0,120}\\b(?:New York Times|BBC|CNN|Washington Post|Guardian|Wired|Forbes|Reuters|Bloomberg|Financial Times|The Verge|TechCrunch|Nature|Science)\\b[^.!?]{0,160}(?:,|and)\\s+[^.!?]{0,80}\\b(?:BBC|CNN|Washington Post|Guardian|Wired|Forbes|Reuters|Bloomberg|Financial Times|The Verge|TechCrunch|Nature|Science)\\b",
      "why": "Listing prominent outlets without a specific sourced claim is a common notability-inflation pattern.",
      "edit": "Cite one concrete claim from one source, or remove the name-dropping.",
      "sources": ["brandonwise/humanizer", "blader/humanizer", "humanizer_academic"],
      "blocking": true
    },
    {
      "rule_id": "repo-regex-reasoning-artifacts",
      "category": "reasoning artifact",
      "priority": "P1",
      "weight": 4,
      "pattern": "\\b(?:let me think(?: about this| through this| step by step)?|let'?s (?:think|reason|work) (?:about|through|this out)|to approach this (?:systematically|methodically|logically)|reasoning through (?:this|the problem|it)|working through the logic|here'?s my (?:thought process|reasoning|thinking)|step (?:[1-9]|one|two|three|four|five):)\\b",
      "why": "Exposed reasoning-chain scaffolding belongs to draft notes or chat, not finished prose.",
      "edit": "Delete the reasoning scaffold or convert it into normal prose.",
      "sources": ["brandonwise/humanizer"],
      "blocking": true
    },
    {
      "rule_id": "repo-regex-acknowledgment-loop",
      "category": "acknowledgment loop",
      "priority": "P1",
      "weight": 4,
      "pattern": "\\b(?:you'?re asking (?:about|whether|if|how|why|what)|the question of (?:whether|how|why|what)|when it comes to your question|in (?:terms of|response to|answer to) your question|to (?:answer|address) your question|your question (?:about|regarding|concerning)|I understand you'?re (?:asking|wondering|curious))\\b",
      "why": "Restating the prompt before answering is a chatbot-response artifact.",
      "edit": "Delete the acknowledgment and answer directly.",
      "sources": ["brandonwise/humanizer"],
      "blocking": true
    },
    {
      "rule_id": "repo-regex-real-actual-inflation",
      "category": "hollow intensifier",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\b(?:real|actual|genuine|true)\\s+(?:utility|value|impact|innovation|sustainability|product-market fit|community|adoption|tokenomics|alignment|insight|transformation)\\b",
      "why": "Real/actual/genuine/true can manufacture an unstated contrast instead of proving the claim.",
      "edit": "Drop the intensifier and name the concrete contrast or evidence.",
      "sources": ["conorbronsdon/avoid-ai-writing"],
      "blocking": true,
      "exceptions": [
        "\\bnot\\s+(?:bridged|fake|simulated|synthetic|superficial|nominal|cosmetic)",
        "\\brather\\s+than\\s+(?:bridged|fake|simulated|synthetic|superficial|nominal|cosmetic)"
      ]
    },
    {
      "rule_id": "repo-regex-generic-future-narrative",
      "category": "generic future narrative",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\b(?:may|could|will|is poised to)\\s+become\\s+(?:one of\\s+)?(?:the\\s+)?(?:most\\s+)?(?:important|defining|major|central|key)\\s+(?:narratives?|stories|trends?|themes?|chapters?|movements?|forces?)\\b",
      "why": "Generic future-prediction closers sound predictive but contain no testable content.",
      "edit": "Replace with a falsifiable forecast, concrete next step, or cut the sentence.",
      "sources": ["conorbronsdon/avoid-ai-writing", "skill-deslop"],
      "blocking": true
    },
    {
      "rule_id": "repo-regex-hashtag-stuffing",
      "category": "hashtag stuffing",
      "priority": "P1",
      "weight": 3,
      "pattern": "(?:#[A-Za-z][\\w-]*\\s*){6,}",
      "why": "Long trailing hashtag blocks are common in generated social posts and rarely help readers.",
      "edit": "Keep two or three specific tags at most, or remove the block.",
      "sources": ["conorbronsdon/avoid-ai-writing"],
      "blocking": true,
      "scan_raw": true,
      "contexts": ["general", "social"]
    },
    {
      "rule_id": "repo-regex-inline-header-list",
      "category": "bold-first bullets",
      "priority": "P1",
      "weight": 3,
      "pattern": "^\\s*[-*+]\\s+\\*\\*[^*\\n:]{1,80}:?\\*\\*\\s*[:\\-]?",
      "why": "Bold-label bullets are a default assistant formatting pattern.",
      "edit": "Convert to prose, normal bullets, or real section headings.",
      "sources": ["brandonwise/humanizer", "humanize-writing", "skill-deslop"],
      "blocking": true,
      "scan_raw": true
    },
    {
      "rule_id": "repo-regex-bare-noun-bullet-run",
      "category": "parallel bare-noun bullets",
      "priority": "P1",
      "weight": 3,
      "pattern": "(?m)(?:^\\s*[-*+]\\s+(?:[A-Z][a-z]+\\s+){0,5}[A-Za-z]+\\s*$\\n?){5,}",
      "why": "Runs of short noun-phrase bullets often read like generated marketing summaries.",
      "edit": "Rewrite as claims with verbs, data, or prose; keep only genuine item lists.",
      "sources": ["conorbronsdon/avoid-ai-writing"],
      "blocking": true,
      "scan_raw": true
    },
    {
      "rule_id": "repo-regex-hidden-unicode-obfuscation",
      "category": "hidden unicode artifact",
      "priority": "P0",
      "weight": 8,
      "pattern": "[\\u200B\\u200C\\u200D\\u2060\\uFEFF\\u00AD]",
      "why": "Hidden zero-width or soft-hyphen characters can be copy/paste residue or detector-evasion artifacts.",
      "edit": "Remove hidden characters unless a formatter explicitly requires them.",
      "sources": ["brandonwise/humanizer"],
      "blocking": true,
      "scan_raw": true
    },
    {
      "rule_id": "repo-regex-not-because-because",
      "category": "formulaic sentence template",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\bnot\\s+because\\s+[^.!?]{3,80}[.!?]\\s+because\\s+[^.!?]{3,100}[.!?]",
      "why": "The not-because/because reversal creates a predictable reveal.",
      "edit": "State the reason directly.",
      "sources": ["stop-slop", "skill-deslop"],
      "blocking": true
    },
    {
      "rule_id": "repo-regex-isnt-the-problem",
      "category": "formulaic sentence template",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\b(?:the\\s+)?[^.!?]{2,50}\\s+(?:isn'?t|is not)\\s+the\\s+problem[.!?]\\s+[^.!?]{2,80}\\s+is[.!?]",
      "why": "The X-isn't-the-problem/Y-is formula is a canned reframe.",
      "edit": "Name the problem directly.",
      "sources": ["stop-slop", "skill-deslop"],
      "blocking": true
    },
    {
      "rule_id": "repo-regex-answer-isnt-x",
      "category": "formulaic sentence template",
      "priority": "P1",
      "weight": 3,
      "pattern": "\\b(?:the\\s+)?(?:answer|question|point|issue|constraint)\\s+(?:isn'?t|is not)\\s+[^.!?]{2,80}[.!?]\\s+(?:it'?s|it is|the\\s+(?:answer|question|point|issue|constraint)\\s+is)\\s+[^.!?]{2,100}[.!?]",
      "why": "The answer-isn't-X/it-is-Y reframe is a polished but canned reversal.",
      "edit": "State the positive claim directly.",
      "sources": ["hardikpandya/stop-slop", "stephenturner/skill-deslop"],
      "blocking": true
    },
    {
      "rule_id": "repo-regex-what-makes-this",
      "category": "rhetorical setup",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\bwhat\\s+makes\\s+(?:this|it|that)\\s+(?:hard|interesting|different|important|tricky)\\s+is\\b",
      "why": "What-makes-this setup phrases announce insight before delivering it.",
      "edit": "Lead with the actual constraint, mechanism, or evidence.",
      "sources": ["hardikpandya/stop-slop"],
      "blocking": false
    },
    {
      "rule_id": "repo-regex-narrator-distance",
      "category": "narrator-from-distance",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\b(?:people\\s+tend\\s+to|this\\s+happens\\s+because|this\\s+is\\s+why|nobody\\s+designed\\s+this)\\b",
      "why": "Distant narrator phrasing can sound generic when it avoids the actor or situation.",
      "edit": "Name the actor, reader, institution, or mechanism when the claim needs one.",
      "sources": ["hardikpandya/stop-slop"],
      "blocking": false
    },
    {
      "rule_id": "repo-regex-listicle-in-prose",
      "category": "listicle prose",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\bthe\\s+first\\s+[^.!?]{1,80}[.!?]\\s+the\\s+second\\s+[^.!?]{1,80}[.!?](?:\\s+the\\s+third\\s+[^.!?]{1,80}[.!?])?",
      "why": "Numbered points disguised as prose often preserve the list structure while hiding the list.",
      "edit": "Use a real list if sequence matters, or merge into prose with only the necessary distinctions.",
      "sources": ["stephenturner/skill-deslop"],
      "blocking": false
    },
    {
      "rule_id": "repo-regex-fractal-summary",
      "category": "fractal summary",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\b(?:in\\s+this\\s+section,?\\s+we(?:'ll|\\s+will)|as\\s+we'?ve\\s+seen|to\\s+sum\\s+up,?\\s+we(?:'ve|\\s+have)\\s+(?:explored|covered|discussed))\\b",
      "why": "Repeated preview-and-recap language makes the document summarize itself instead of advancing.",
      "edit": "Delete preview/recap scaffolding unless it is required by the genre.",
      "sources": ["stephenturner/skill-deslop", "hardikpandya/stop-slop"],
      "blocking": false
    },
    {
      "rule_id": "repo-regex-historical-analogy-stacking",
      "category": "historical analogy stacking",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\b(?:Apple|Facebook|Google|Microsoft|Stripe|AWS|Uber|Airbnb|Spotify|Shopify|Netflix)\\b[^.!?]{0,120}\\b(?:Apple|Facebook|Google|Microsoft|Stripe|AWS|Uber|Airbnb|Spotify|Shopify|Netflix)\\b[^.!?]{0,120}\\b(?:Apple|Facebook|Google|Microsoft|Stripe|AWS|Uber|Airbnb|Spotify|Shopify|Netflix)\\b",
      "why": "Rapid-fire company analogy stacks can create false authority without analysis.",
      "edit": "Keep the one analogy that proves the point, then state the mechanism.",
      "sources": ["stephenturner/skill-deslop"],
      "blocking": false
    },
    {
      "rule_id": "repo-regex-dead-metaphor-repeat",
      "category": "dead metaphor repetition",
      "priority": "P2",
      "weight": 2,
      "pattern": "\\b(ecosystem|flywheel|moat|wall|door|primitive|engine|vehicle|pipeline|landscape)\\b[^.!?]{0,160}\\b\\1\\b[^.!?]{0,160}\\b\\1\\b",
      "why": "Repeating the same metaphor several times can make prose feel generated or padded.",
      "edit": "Keep the metaphor once, then use concrete terms.",
      "sources": ["stephenturner/skill-deslop", "sam-paech/antislop-sampler"],
      "blocking": false
    }
  ],
