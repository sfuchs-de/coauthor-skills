\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bq-theme}[2026/09/07 Minimalist research seminar style]
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[scaled=.9]{helvet}
\RequirePackage{amsmath,amssymb,booktabs,graphicx,etoolbox,tikz}
\definecolor{BQBlue}{rgb}{.2,.2,.7}
\definecolor{BQRed}{HTML}{B22C2C}
\renewcommand{\familydefault}{\sfdefault}
\linespread{1}
\setbeamersize{text margin left=3mm,text margin right=3mm}
\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{structure}{fg=BQBlue}
\setbeamercolor{title}{fg=BQBlue}
\setbeamercolor{frametitle}{fg=BQBlue}
\setbeamercolor{itemize item}{fg=BQBlue}
\setbeamercolor{itemize subitem}{fg=BQBlue}
\setbeamerfont{title}{size=\Large,series=\mdseries}
\setbeamerfont{frametitle}{size=\Large,series=\mdseries}
\setbeamerfont*{itemize/enumerate body}{}
\setbeamerfont{itemize/enumerate subbody}{size=\small}
\setbeamerfont{itemize/enumerate subsubbody}{size=\footnotesize}
\setbeamertemplate{frametitle}[default]
\setbeamertemplate{itemize item}[triangle]
\setbeamertemplate{itemize subitem}[triangle]
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamertemplate{navigation symbols}{}
\setbeamercovered{invisible}
\hypersetup{colorlinks,linkcolor=BQBlue,citecolor=black,urlcolor=BQBlue,
  pdfpagemode=UseNone,pdfstartview={Fit}}
\AtBeginSection[]{}

\newif\ifBQAppendix
\BQAppendixfalse
\newenvironment{BQList}{\begin{itemize}\ifBQAppendix\setlength{\itemsep}{15pt}\else\setlength{\itemsep}{18pt}\fi\setlength{\parskip}{0pt}\setlength{\parsep}{0pt}}{\end{itemize}}
\newenvironment{BQCompact}[1][13pt]{\begin{itemize}\ifBQAppendix\setlength{\itemsep}{9pt}\else\setlength{\itemsep}{#1}\fi\setlength{\parskip}{0pt}\setlength{\parsep}{0pt}}{\end{itemize}}
\newenvironment{BQSub}{\begin{itemize}\ifBQAppendix\setlength{\itemsep}{4pt}\else\setlength{\itemsep}{5pt}\fi\setlength{\topsep}{3pt}\setlength{\parskip}{0pt}\setlength{\parsep}{0pt}}{\end{itemize}}
\newcommand{\BQLead}[1]{\begin{itemize}\item #1\end{itemize}}
\newcommand{\BQNote}[1]{\par\vspace{5pt}{\small #1\par}}
\newcommand{\BQSource}[1]{\par\vspace{4pt}{\footnotesize #1\par}}
\newcommand{\BQFigure}[3][]{\par\begingroup\centering\includegraphics[width=\linewidth,height=#2,keepaspectratio,#1]{#3}\par\endgroup}
\newcommand{\backupbtn}[2]{\hyperlink{#1}{\textcolor{BQBlue}{\underline{#2}}}}
\newcommand{\BQReturnTarget}{bq_main_end}
\newcommand{\BQReturnText}{Back to conclusion}
\newcommand{\setappendixreturn}[2]{\renewcommand{\BQReturnTarget}{#1}\renewcommand{\BQReturnText}{#2}}
\newcommand{\BQAppendix}{\appendix\BQAppendixtrue}

% Frame-local footer links do not consume body height or leak across reveals.
\makeatletter
\let\BQFooterLinks\@empty
\newcommand{\BQBottomLinks}[1]{\gdef\BQFooterLinks{#1}}
\BeforeBeginEnvironment{beamer@frameslide}{\global\let\BQFooterLinks\@empty}
\newcommand{\BQRenderFooter}{%
  \onslide<1->\begingroup
  \let\BQFooterRow\BQFooterLinks
  \ifBQAppendix\ifbeamer@plainframe\else
    \ifx\BQFooterRow\@empty\else\appto\BQFooterRow{\quad}\fi
    \appto\BQFooterRow{\backupbtn{\BQReturnTarget}{\BQReturnText}}%
  \fi\fi
  \ifx\BQFooterRow\@empty\else
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=south east,inner sep=0pt,font=\scriptsize]
      at ([xshift=-3mm,yshift=2mm]current page.south east) {\BQFooterRow};
    \end{tikzpicture}%
  \fi\endgroup}
\AtEndEnvironment{beamer@frameslide}{\BQRenderFooter}
\makeatother
\newcommand{\BQAgenda}[2]{%
  \begin{frame}[noframenumbering]{Agenda}
  \foreach \heading [count=\idx] in {#2}{%
    {\ifnum\idx=#1\color{BQBlue}\else\color{BQBlue!20}\fi\heading\par}\vspace{21pt}}
  \end{frame}}
